# FamilyFocalSync — example environment file
#
# This file documents the environment variables consumed by the FamilyFocal
# edge functions and the supabase self-hosting stack.
#
# 1) The variables in the [supabase] block are owned by the upstream
#    supabase/docker `.env`. Keep them in sync with that file — this list
#    only documents the ones FamilyFocal cares about.
# 2) The variables in the [familyfocal] block are FamilyFocal-specific.
#    Set them as supabase secrets (`supabase secrets set FOO=bar`) so the
#    edge functions can read them at runtime.
#
# Copy this file to `.env` (or the appropriate location for your setup) and
# fill in the values. `.env` is gitignored.

# ---------------------------------------------------------------------------
# [supabase] — set in supabase/docker/.env
# ---------------------------------------------------------------------------

# Strong random password for the embedded Postgres instance.
POSTGRES_PASSWORD=

# At least 32 random characters. ANON_KEY and SERVICE_ROLE_KEY are derived
# from this — see the Supabase self-hosting docs.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Public URL of your sync server. Same value for both.
SITE_URL=https://sync.example.com
API_EXTERNAL_URL=https://sync.example.com

# Outgoing email — required from Phase 5 (magic-link onboarding) onwards.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=FamilyFocal
SMTP_ADMIN_EMAIL=

# Email signup behaviour.
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

# ---------------------------------------------------------------------------
# [familyfocal] — set as supabase secrets
# ---------------------------------------------------------------------------

# QR-onboarding token TTL, in minutes. Tokens are redeemed in-person, so a
# short window is the right default. ADR-3 in the implementation plan.
JOIN_TOKEN_TTL_MINUTES=10

# Email-invite (magic-link) token TTL, in minutes. The recipient may not
# read their inbox immediately, so this is intentionally generous.
# 10080 minutes = 7 days. Used by `invite-by-email` from Phase 5.
INVITE_TTL_MINUTES=10080
